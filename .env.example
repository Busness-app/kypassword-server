# KyPassword Server configuration.
#
# KySignOn is the only authenticator. The three OIDC values below are required and must be
# set together — a partially set environment is treated as unset, so a typo cannot produce
# a configuration that is half environment and half config/sso.json. They take precedence
# over config/sso.json, and the admin UI refuses (409) to overwrite them.
#
# Without them the server will not start: it could authenticate nobody, and there is no
# local administrator who could fix it from the UI.

KYPASSWORD_OIDC_ISSUER=https://signon.example.com
KYPASSWORD_OIDC_CLIENT_ID=kypassword
KYPASSWORD_OIDC_CLIENT_SECRET=

# Defaults to <scheme>://<host>/api/auth/oidc/callback. Set it when a reverse proxy makes
# the externally visible URL differ from what the server sees.
#KYPASSWORD_OIDC_REDIRECT_URI=https://vault.example.com/api/auth/oidc/callback

# true (default): anyone KySignOn authenticates gets an account and an empty vault on first
# sign-in. false: only accounts KySignOn has explicitly replicated — verify replication
# works before setting this, or nobody can get in.
#KYPASSWORD_OIDC_AUTO_PROVISION=true

PORT=5877
DATA_DIR=./data
CONFIG_DIR=./config
RETENTION_DAYS=90

# Shared secret for KySignOn replication and device pairing. Generated into
# CONFIG_DIR/pairing.secret if left unset.
#PAIRING_SECRET=

# Sealed KyRecovery deposit schedule. Use 0 to disable; nonzero values below 15m
# are rejected at startup.
#KYPASSWORD_BACKUP_DEPOSIT_INTERVAL=24h

# HMAC key for the audit chain: exactly 32 bytes, written as 64 hex characters
# or as standard base64. Not a minimum — a longer value is refused at startup,
# because a key half of which is silently discarded is a key two installs can
# disagree about. Generated into CONFIG_DIR/audit.key if left unset, and that
# file's contents are the same 64 hex characters this takes.
#
# Keep it out of DATA_DIR: a key stored beside the audit log lets anyone who can
# write the log forge it. Losing or changing this key means the existing chain
# can no longer be verified.
#
#   openssl rand -hex 32
#
#AUDIT_KEY=

# CONFIG_DIR also holds audit.state, the record of how long the audit log should
# be. It is what makes a deleted or truncated log detectable, so back CONFIG_DIR
# up alongside DATA_DIR.
